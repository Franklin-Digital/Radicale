# Radicale rights — Franklin Digital (DAYTRADE-778)
#
# Evaluated TOP-DOWN; the FIRST matching section wins. Order is load-bearing:
# put a broad rule above a narrow one and the narrow one becomes unreachable.
#
# {0} interpolates the authenticated username.
#
# SHARED CALENDARS LIVE UNDER THE `calendar-publisher` PRINCIPAL, not under a
# synthetic "shared" path. Radicale has no concept of an ownerless collection:
# every collection sits under some principal, and that principal must be a real
# authenticated user. An earlier draft of this file granted rights on
# /shared/... -- a path nothing would ever create.
#
# Note this file is ordered publisher-first. The owner rules below match
# `user = .+` on `{0}/.*`, which WOULD match calendar-publisher's own paths;
# placing the read-only rule after them would make it unreachable and silently
# give every user read-write on the shared calendars.

# --- the shared, DERIVED calendars ---------------------------------------
# Earnings + Economic Indicator. Written by the publisher job from data
# Franklin already owns (FMP earnings calendar, economic indicators). Readable
# by every AUTHENTICATED user -- `user = .+` means authenticated, never
# anonymous, since an unauthenticated request never reaches this file.

[shared-calendars-readonly]
# MUST precede the owner rules, or `{0}/.*` would match first for the
# publisher and grant rw to whoever is logged in as them.
user = .+
collection = calendar-publisher/(earnings|economic-indicators)
permissions = r

[shared-discovery]
# Clients PROPFIND the parent to enumerate collections; without read on the
# principal itself, discovery returns nothing and the calendars look absent.
user = .+
collection = calendar-publisher
permissions = R

[shared-publisher-write]
# The publisher is the ONLY writer, so a misconfigured client cannot corrupt a
# derived calendar.
user = calendar-publisher
collection = calendar-publisher/.*
permissions = rw

# --- each user owns their own home collection ----------------------------
# Discovery PROPFINDs the principal path first, so without this a client
# cannot enumerate anything at all.

[owner-root]
user = .+
collection = {0}
permissions = RW

[owner-collections]
user = .+
collection = {0}/.*
permissions = rw
