# Radicale rights — Franklin Digital (DAYTRADE-778)
#
# FIRST MATCHING RULE WINS (user AND collection both match). Order is not
# cosmetic: a broad rule above a narrow one makes the narrow one unreachable.
#
# PERMISSION LETTERS (from the shipped upstream `rights` example, not guessed):
#   R / W  apply to the PRINCIPAL (parent) collection -- W is what permits
#          CREATING a calendar beneath it, e.g. MKCALENDAR
#   r / w  apply to the calendars/address books themselves
#   i      HTTP GET only; for unauthenticated access. Not used here.
#
# {0} interpolates the whole `user` match (group 0).
#
# SHARED CALENDARS LIVE UNDER THE `calendar-publisher` PRINCIPAL. Radicale has
# no ownerless collections -- every collection sits under a principal and a
# principal must be a real authenticated user (id=3 in the dashboard `users`
# table). An earlier draft granted rights on /shared/..., a path nothing would
# ever create.

# --- publisher: MUST come first ------------------------------------------
# These name a specific user, so they have to precede the `user = .+` rules
# below. With the read-only rule first, the publisher matched it and got `r`
# on its own calendars -- MKCALENDAR then returned 403 (measured, 2026-09-16).
# Note 403 not 401: authentication had SUCCEEDED and authorization refused.

[publisher-principal]
# W on the principal is what allows creating the calendars beneath it.
user = calendar-publisher
collection = calendar-publisher
permissions = RW

[publisher-calendars]
user = calendar-publisher
collection = calendar-publisher/[^/]+
permissions = rw

# --- everyone else: read-only on the shared calendars --------------------
# `user = .+` means AUTHENTICATED, never anonymous -- an unauthenticated
# request never reaches this file.

[shared-discovery]
# R on the principal so clients can PROPFIND it and enumerate. Without this
# the calendars exist but are invisible to discovery.
user = .+
collection = calendar-publisher
permissions = R

[shared-calendars-readonly]
# Named explicitly rather than [^/]+ so a future calendar under this principal
# is private until someone deliberately adds it here.
user = .+
collection = calendar-publisher/(earnings|economic-indicators)
permissions = r

# --- each user's own home collection -------------------------------------
# Discovery PROPFINDs the principal path first; without these a client cannot
# enumerate anything of its own.

[owner-principal]
user = .+
collection = {0}
permissions = RW

[owner-calendars]
user = .+
collection = {0}/[^/]+
permissions = rw
